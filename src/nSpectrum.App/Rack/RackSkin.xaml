<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:rack="clr-namespace:nSpectrum.App.Rack">
  <!-- Retro hi-fi rack skin: brushed metal faceplates, walnut cheeks, dark push buttons with amber
       lettering, recessed amber displays. Textures come from RackTextures (procedural). -->

  <FontFamily x:Key="RackFont">Segoe UI Variable Display, Segoe UI</FontFamily>
  <Color x:Key="RackAmberColor">#FFB238</Color>
  <SolidColorBrush x:Key="RackAmber" Color="#FFB238"/>
  <SolidColorBrush x:Key="RackAmberDim" Color="#C7924A"/>
  <SolidColorBrush x:Key="RackText" Color="#E4DFD5"/>
  <SolidColorBrush x:Key="RackEngraveInk" Color="#B9B1A4"/>
  <SolidColorBrush x:Key="RackHeaderInk" Color="#D9D2C4"/>
  <rack:UpperCaseConverter x:Key="Upper"/>

  <DropShadowEffect x:Key="RackAmberGlow" Color="#FF961E" ShadowDepth="0" BlurRadius="9" Opacity="0.9"/>
  <DropShadowEffect x:Key="RackAmberGlowSoft" Color="#FF961E" ShadowDepth="0" BlurRadius="7" Opacity="0.55"/>
  <DropShadowEffect x:Key="RackEngraved" Color="Black" ShadowDepth="1" Direction="90" BlurRadius="0" Opacity="0.75"/>

  <LinearGradientBrush x:Key="RackPlateGradient" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#615B54" Offset="0"/>
    <GradientStop Color="#4A4540" Offset="0.14"/>
    <GradientStop Color="#3D3935" Offset="0.5"/>
    <GradientStop Color="#34302D" Offset="0.86"/>
    <GradientStop Color="#2A2725" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="RackRailGradient" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#A7A199" Offset="0"/>
    <GradientStop Color="#77716A" Offset="0.45"/>
    <GradientStop Color="#4D4843" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="RackWoodGradient" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#3B1607" Offset="0"/>
    <GradientStop Color="#7A3A17" Offset="0.22"/>
    <GradientStop Color="#9A5326" Offset="0.45"/>
    <GradientStop Color="#7D3C18" Offset="0.7"/>
    <GradientStop Color="#4A1C09" Offset="1"/>
  </LinearGradientBrush>

  <!-- Screws, plates, cheeks -->
  <Style x:Key="RackScrew" TargetType="ContentControl">
    <Setter Property="Width" Value="17"/>
    <Setter Property="Height" Value="17"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Grid>
            <Ellipse Fill="#1F1D1B" Stroke="#1EFFFFFF" StrokeThickness="1"/>
            <Ellipse Margin="2">
              <Ellipse.Fill>
                <RadialGradientBrush GradientOrigin="0.4,0.35" Center="0.4,0.35" RadiusX="0.65" RadiusY="0.65">
                  <GradientStop Color="#BDB7AE" Offset="0"/>
                  <GradientStop Color="#77716A" Offset="0.45"/>
                  <GradientStop Color="#2E2B29" Offset="1"/>
                </RadialGradientBrush>
              </Ellipse.Fill>
            </Ellipse>
            <Rectangle Width="9" Height="2" Fill="#26231F" RenderTransformOrigin="0.5,0.5">
              <Rectangle.RenderTransform><RotateTransform Angle="35"/></Rectangle.RenderTransform>
            </Rectangle>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A brushed-metal faceplate with a chrome top rail and a screw in each corner. -->
  <Style x:Key="RackPlate" TargetType="ContentControl">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Grid>
            <Border Background="{StaticResource RackPlateGradient}" BorderBrush="#141211" BorderThickness="0,0,0,1"/>
            <Border Background="{DynamicResource RackBrushedTexture}"/>
            <Border VerticalAlignment="Bottom" Height="4">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="#00000000" Offset="0"/>
                  <GradientStop Color="#80000000" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
            </Border>
            <Border VerticalAlignment="Top" Height="10" Background="{StaticResource RackRailGradient}" BorderThickness="0,1,0,1">
              <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="#9C968D" Offset="0"/>
                  <GradientStop Color="#9C968D" Offset="0.1"/>
                  <GradientStop Color="#1D1B19" Offset="0.9"/>
                  <GradientStop Color="#1D1B19" Offset="1"/>
                </LinearGradientBrush>
              </Border.BorderBrush>
            </Border>
            <Border VerticalAlignment="Top" Margin="0,10,0,0" Height="2" Background="#1FFFFFFF"/>
            <ContentControl Style="{StaticResource RackScrew}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7,18,0,0"/>
            <ContentControl Style="{StaticResource RackScrew}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="7,0,0,8"/>
            <ContentControl Style="{StaticResource RackScrew}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,7,0"/>
            <ContentControl Style="{StaticResource RackScrew}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,7,8"/>
            <ContentPresenter Margin="{TemplateBinding Padding}"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Walnut side cheek. Tag "L" or "R" picks the rounded side. -->
  <Style x:Key="RackCheek" TargetType="ContentControl">
    <Setter Property="Width" Value="22"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Grid>
            <Border x:Name="wood" Background="{StaticResource RackWoodGradient}" CornerRadius="9,0,0,9"/>
            <Border x:Name="grain" Background="{DynamicResource RackWoodTexture}" CornerRadius="9,0,0,9"/>
            <Border x:Name="edge" CornerRadius="9,0,0,9" BorderThickness="3,0,0,0" BorderBrush="#2EFFBE8C"/>
            <Border x:Name="inner" CornerRadius="9,0,0,9" BorderThickness="0,0,2,0" BorderBrush="#99000000"/>
            <Border VerticalAlignment="Top" Margin="6,6,6,0" Height="10" CornerRadius="3">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="#40FFD2AA" Offset="0"/>
                  <GradientStop Color="#00FFD2AA" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Tag" Value="R">
              <Setter TargetName="wood" Property="CornerRadius" Value="0,9,9,0"/>
              <Setter TargetName="grain" Property="CornerRadius" Value="0,9,9,0"/>
              <Setter TargetName="edge" Property="CornerRadius" Value="0,9,9,0"/>
              <Setter TargetName="edge" Property="BorderThickness" Value="0,0,3,0"/>
              <Setter TargetName="inner" Property="CornerRadius" Value="0,9,9,0"/>
              <Setter TargetName="inner" Property="BorderThickness" Value="2,0,0,0"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Section header and field labels, engraved into the plate. Use rack:RackProps.Engrave for the text. -->
  <Style x:Key="RackHeader" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource RackFont}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource RackHeaderInk}"/>
    <Setter Property="Effect" Value="{StaticResource RackEngraved}"/>
    <Setter Property="Margin" Value="0,0,0,12"/>
  </Style>
  <Style x:Key="RackFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource RackHeader}">
    <Setter Property="FontSize" Value="10.5"/>
    <Setter Property="Foreground" Value="{StaticResource RackEngraveInk}"/>
    <Setter Property="Margin" Value="0,0,0,5"/>
  </Style>
  <!-- Large silk-screen lettering on the rack (POWER, INPUT, the title). -->
  <Style x:Key="RackLegend" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource RackFont}"/>
    <Setter Property="FontSize" Value="18"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource RackText}"/>
    <Setter Property="Effect" Value="{StaticResource RackEngraved}"/>
    <Setter Property="TextAlignment" Value="Center"/>
  </Style>

  <!-- Push buttons -->
  <LinearGradientBrush x:Key="RackFaceNormal" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#3D3A37" Offset="0"/>
    <GradientStop Color="#2A2826" Offset="0.45"/>
    <GradientStop Color="#1B1A19" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="RackFaceHover" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#47433F" Offset="0"/>
    <GradientStop Color="#302D2B" Offset="0.45"/>
    <GradientStop Color="#1E1D1C" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="RackFaceLit" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#4A3826" Offset="0"/>
    <GradientStop Color="#2E2217" Offset="0.45"/>
    <GradientStop Color="#1D1610" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="RackFacePressed" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#262422" Offset="0"/>
    <GradientStop Color="#1E1C1B" Offset="0.45"/>
    <GradientStop Color="#151413" Offset="1"/>
  </LinearGradientBrush>
  <Style TargetType="rack:RackChrome">
    <Setter Property="Foreground" Value="#DCD7CE"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="rack:RackChrome">
          <Grid>
            <!-- amber halo when lit -->
            <Border x:Name="halo" CornerRadius="13" Margin="-3" Background="#55FF8C1E" Opacity="0">
              <Border.Effect><BlurEffect Radius="12"/></Border.Effect>
            </Border>
            <Border x:Name="bezel" CornerRadius="11" Background="#1C1A18" Padding="3" BorderBrush="#12FFFFFF" BorderThickness="1">
              <Border.Effect><DropShadowEffect ShadowDepth="4" Direction="270" BlurRadius="7" Opacity="0.6"/></Border.Effect>
              <Border x:Name="face" CornerRadius="8" BorderBrush="#0A0909" BorderThickness="1" Background="{StaticResource RackFaceNormal}">
                <Grid>
                  <Border CornerRadius="7" BorderThickness="0,1,0,0" BorderBrush="#2EFFFFFF"/>
                  <Border CornerRadius="7" BorderThickness="0,0,0,2" BorderBrush="#8C000000"/>
                  <StackPanel x:Name="content" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}">
                    <Grid x:Name="led" Width="9" Height="9" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Collapsed">
                      <Ellipse x:Name="ledGlow" Margin="-4" Fill="#FFFF961E" Opacity="0">
                        <Ellipse.Effect><BlurEffect Radius="6"/></Ellipse.Effect>
                      </Ellipse>
                      <Ellipse x:Name="ledOff" Stroke="#0B0A09" StrokeThickness="1">
                        <Ellipse.Fill>
                          <RadialGradientBrush GradientOrigin="0.4,0.35" Center="0.4,0.35">
                            <GradientStop Color="#6B4A2A" Offset="0"/>
                            <GradientStop Color="#2A1B0F" Offset="1"/>
                          </RadialGradientBrush>
                        </Ellipse.Fill>
                      </Ellipse>
                      <Ellipse x:Name="ledOn" Stroke="#3A2306" StrokeThickness="1" Opacity="0">
                        <Ellipse.Fill>
                          <RadialGradientBrush GradientOrigin="0.4,0.35" Center="0.4,0.35">
                            <GradientStop Color="#FFF1C4" Offset="0"/>
                            <GradientStop Color="#FFB238" Offset="0.4"/>
                            <GradientStop Color="#D26A00" Offset="1"/>
                          </RadialGradientBrush>
                        </Ellipse.Fill>
                      </Ellipse>
                    </Grid>
                    <ContentPresenter x:Name="label" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                  </StackPanel>
                </Grid>
              </Border>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="ShowLed" Value="True">
              <Setter TargetName="led" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="Hover" Value="True">
              <Setter TargetName="face" Property="Background" Value="{StaticResource RackFaceHover}"/>
            </Trigger>
            <Trigger Property="Lit" Value="True">
              <Setter Property="Foreground" Value="{StaticResource RackAmber}"/>
              <Setter TargetName="label" Property="Effect" Value="{StaticResource RackAmberGlow}"/>
              <Setter TargetName="halo" Property="Opacity" Value="0.55"/>
              <Setter TargetName="bezel" Property="BorderBrush" Value="#40FFA03C"/>
              <Setter TargetName="face" Property="Background" Value="{StaticResource RackFaceLit}"/>
              <Setter TargetName="ledOn" Property="Opacity" Value="1"/>
              <Setter TargetName="ledGlow" Property="Opacity" Value="0.85"/>
            </Trigger>
            <Trigger Property="Pressed" Value="True">
              <Setter TargetName="content" Property="RenderTransform">
                <Setter.Value><TranslateTransform Y="1"/></Setter.Value>
              </Setter>
              <Setter TargetName="face" Property="Background" Value="{StaticResource RackFacePressed}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Large rack buttons (SPEC, 1/3 OCT, PEAK, RMS, the gear). -->
  <Style x:Key="RackButton" TargetType="ButtonBase">
    <Setter Property="FontFamily" Value="{StaticResource RackFont}"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Height" Value="38"/>
    <Setter Property="MinWidth" Value="76"/>
    <Setter Property="Padding" Value="14,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ButtonBase">
          <rack:RackChrome Padding="{TemplateBinding Padding}" Content="{TemplateBinding Content}"
                           Lit="{TemplateBinding rack:RackProps.Lit}" ShowLed="{TemplateBinding rack:RackProps.Led}"
                           Pressed="{TemplateBinding IsPressed}" Hover="{TemplateBinding IsMouseOver}"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="RackToggle" TargetType="ToggleButton" BasedOn="{StaticResource RackButton}">
    <Setter Property="rack:RackProps.Lit" Value="{Binding IsChecked, RelativeSource={RelativeSource Self}}"/>
  </Style>
  <!-- Small buttons on the options panel. -->
  <Style x:Key="RackSmallButton" TargetType="ButtonBase" BasedOn="{StaticResource RackButton}">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="Padding" Value="12,0"/>
  </Style>
  <Style x:Key="RackSmallToggle" TargetType="ToggleButton" BasedOn="{StaticResource RackSmallButton}">
    <Setter Property="rack:RackProps.Lit" Value="{Binding IsChecked, RelativeSource={RelativeSource Self}}"/>
    <Setter Property="rack:RackProps.Led" Value="True"/>
    <Setter Property="Padding" Value="10,0"/>
  </Style>

  <!-- A row of small buttons where exactly one is lit (channel, weighting, rate). -->
  <Style x:Key="RackSegment" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <ItemsPresenter/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="ItemContainerStyle">
      <Setter.Value>
        <Style TargetType="ListBoxItem">
          <Setter Property="FontFamily" Value="{StaticResource RackFont}"/>
          <Setter Property="FontSize" Value="14"/>
          <Setter Property="FontWeight" Value="SemiBold"/>
          <Setter Property="Height" Value="34"/>
          <Setter Property="MinWidth" Value="38"/>
          <Setter Property="Margin" Value="0,0,7,0"/>
          <Setter Property="Padding" Value="8,0"/>
          <Setter Property="Cursor" Value="Hand"/>
          <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <rack:RackChrome Padding="{TemplateBinding Padding}"
                                 Content="{Binding Converter={StaticResource Upper}}"
                                 Lit="{TemplateBinding IsSelected}" Hover="{TemplateBinding IsMouseOver}"/>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Amber displays (drop-downs) -->
  <Style x:Key="RackDisplayFrame" TargetType="Border">
    <Setter Property="CornerRadius" Value="9"/>
    <Setter Property="Background" Value="#24211F"/>
    <Setter Property="Padding" Value="2"/>
    <Setter Property="BorderBrush" Value="#14FFFFFF"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
  </Style>

  <Style x:Key="RackSelectItem" TargetType="ComboBoxItem">
    <Setter Property="FontFamily" Value="{StaticResource RackFont}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource RackAmberDim}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="bd" CornerRadius="5" Padding="12,7" Background="Transparent">
            <ContentPresenter x:Name="text"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#14FFA032"/>
              <Setter Property="Foreground" Value="#E8A748"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#1FFFA032"/>
              <Setter Property="Foreground" Value="{StaticResource RackAmber}"/>
              <Setter TargetName="text" Property="Effect" Value="{StaticResource RackAmberGlowSoft}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="RackSelect" TargetType="ComboBox">
    <Setter Property="FontFamily" Value="{StaticResource RackFont}"/>
    <Setter Property="FontSize" Value="14.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Height" Value="38"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource RackSelectItem}"/>
    <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="frame" Style="{StaticResource RackDisplayFrame}">
                    <Border CornerRadius="7" BorderBrush="Black" BorderThickness="1">
                      <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                          <GradientStop Color="#070807" Offset="0"/>
                          <GradientStop Color="#121412" Offset="1"/>
                        </LinearGradientBrush>
                      </Border.Background>
                      <Grid>
                        <Border VerticalAlignment="Top" Height="7" CornerRadius="6,6,0,0">
                          <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                              <GradientStop Color="#E6000000" Offset="0"/>
                              <GradientStop Color="#00000000" Offset="1"/>
                            </LinearGradientBrush>
                          </Border.Background>
                        </Border>
                        <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,1,10,0"
                              Data="M0,0 L10,0 L5,6 Z" Fill="#C98A2E"/>
                      </Grid>
                    </Border>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="frame" Property="Background" Value="#6A4A1F"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="frame" Property="Background" Value="#3A332B"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <TextBlock IsHitTestVisible="False" Margin="14,0,28,0" VerticalAlignment="Center"
                       Text="{Binding SelectionBoxItem, RelativeSource={RelativeSource TemplatedParent}}"
                       TextTrimming="CharacterEllipsis" Foreground="{StaticResource RackAmber}"
                       Effect="{StaticResource RackAmberGlowSoft}"/>
            <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="4" AllowsTransparency="True" Focusable="False"
                   PopupAnimation="Fade" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
              <Border Margin="0,0,14,18" Padding="6" CornerRadius="8" BorderBrush="#2C2825" BorderThickness="2"
                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="380">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#141513" Offset="0"/>
                    <GradientStop Color="#0A0B0A" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
                <Border.Effect><DropShadowEffect ShadowDepth="8" Direction="300" BlurRadius="18" Opacity="0.75"/></Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Editable amber readout under a knob (generator frequency and level). -->
  <Style x:Key="RackReadout" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource RackFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource RackAmber}"/>
    <Setter Property="CaretBrush" Value="{StaticResource RackAmber}"/>
    <Setter Property="SelectionBrush" Value="#FFB238"/>
    <Setter Property="TextAlignment" Value="Center"/>
    <Setter Property="Width" Value="68"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border CornerRadius="6" Background="#24211F" Padding="2">
            <Border CornerRadius="5" Background="#0A0B0A" BorderBrush="Black" BorderThickness="1">
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Effect="{StaticResource RackAmberGlowSoft}"/>
            </Border>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Thin engraved groove between sections of the options panel. -->
  <Style x:Key="RackGroove" TargetType="Border">
    <Setter Property="Width" Value="2"/>
    <Setter Property="Margin" Value="0,4"/>
    <Setter Property="Background">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
          <GradientStop Color="#8C000000" Offset="0"/>
          <GradientStop Color="#8C000000" Offset="0.5"/>
          <GradientStop Color="#14FFFFFF" Offset="0.5"/>
          <GradientStop Color="#14FFFFFF" Offset="1"/>
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
