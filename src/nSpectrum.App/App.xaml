<Application x:Class="nSpectrum.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <!-- The rack skin: faceplates, buttons, displays, knobs. Textures are added in App.OnStartup. -->
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Rack/RackSkin.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
