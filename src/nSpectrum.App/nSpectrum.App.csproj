<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>nSpectrum.App</RootNamespace>
    <AssemblyName>nSpectrum</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <IsPackable>false</IsPackable>
    <!-- WPF has no Native AOT; ship ReadyToRun with tiered PGO instead. -->
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishReadyToRun>true</PublishReadyToRun>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../nSpectrum.Core/nSpectrum.Core.csproj" />
    <ProjectReference Include="../nSpectrum.Capture/nSpectrum.Capture.csproj" />
    <ProjectReference Include="../nSpectrum.Wpf/nSpectrum.Wpf.csproj" />
    <ProjectReference Include="../nSpectrum.Visuals/nSpectrum.Visuals.csproj" />
  </ItemGroup>
</Project>
