<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Lets the Windows-only projects compile on Linux/macOS build agents. They only run on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <Authors>Duško and nSpectrum contributors</Authors>
    <Copyright>Copyright (c) 2026 Duško and nSpectrum contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/duskozi/nSpectrum</PackageProjectUrl>
    <RepositoryUrl>https://github.com/duskozi/nSpectrum</RepositoryUrl>
    <Version>0.1.0-alpha</Version>
  </PropertyGroup>
</Project>
